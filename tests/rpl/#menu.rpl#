(bundle "pack/common.rpk")
(bundle "pack/main-menu.rpk")

(assets
 (texture kv "key-visual")
 (texture contract "contract")
 (texture start "btn-start")
 (texture load "btn-load")
 (texture continue "btn-continue")
 (texture gallery "btn-gallery")
 (texture config "btn-config")
 (texture exit "btn-exit")
 (texture start-h "btn-start-chosen")
 (texture load-h "btn-load-chosen")
 (texture continue-h "btn-continue-chosen")
 (texture gallery-h "btn-gallery-chosen")
 (texture config-h "btn-config-chosen")
 (texture exit-h "btn-exit-chosen")
 (typeface main-font "xiaolai.atlas" "xiaolai.bin")
 (sound sign "sign"))

(prefab hoverd-btn (no ho cl)
	(interact 480 180
		  [(click) cl]
		  [(hover) (show ho)]
		  [else (show no)]))

(prefab menu-buttons ()
	(parallel
	 (at 0 0 (hoverd-btn start start-h (play sign)))
	 (at 0 200 (hoverd-btn continue continue-h (play sign)))
	 (at 0 400 (hoverd-btn load load-h (play sign)))
	 (at 0 600 (hoverd-btn gallery gallery-h (play sign)))
	 (at 0 800 (hoverd-btn config config-h (play sign)))
	 (at 0 1000 (hoverd-btn exit exit-h (play sign)))))

(parallel
 (scale 0.5
	(parallel
	 (show kv)
	 (show contract)))
(rotate 45
(scale 10
(color 0 255 0 100
(typeface main-font
 (label "这只是个测试")))))
 
 (at 710 250
     (scale 0.5
	    (menu-buttons))))

