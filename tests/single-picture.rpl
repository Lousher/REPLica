(define ress
  `[(texture morning "bg-morning")
    (texture afternoon "bg-afternoon")
    (texture evening "bg-evening")
    (texture night "bg-night")
    (effect fade #f "fade.fs")
    (transition wakeup #f "wakeup.fs")])

(define left-up-corner (rectangle 0 0 200 200))
(define hovered-or-clicked-on?
  (lambda (area)
    (race (hovered? area) (clicked? area))))

(define ani (lambda (tex) (fade (static tex) 2)))

(stage test
       (bundle "single.rpk" "patch.rpk")
       (resources ress)
       (interactions
	((hovered-or-clicked-on? left-up-corner)
	 (ani morning))
	(none
	 (ani afternoon))
	(none
	 (ani evening))
	(none
	 (ani night))))

