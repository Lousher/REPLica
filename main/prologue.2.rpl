(load "prologue.2.def")

(static black)

(chain
(static black) 0.5
(fade (store-zoom (background morning)) 2)
(play street)
(play lawson)
2 (play plastic)
1 (normal "哈……"))

(chain
 (store-zoom (background morning))
 (play plastic)
 (normal "玉米三块，包子也三块，这也太贵了"))

(define masked-move
  (mask (store-move (background morning)) 1))

(chain
 masked-move 1
 (play walking)
 (normal "(应该买套餐的啊)"))

(chain
 masked-move

 (normal "好烫！"))

(chain
 masked-move
 (stop walking)
 (normal "呼呼……"))

(chain
 masked-move
 (normal "(感觉，好久没吃早餐了)"))

(chain
 masked-move
 (normal "(难得被吵醒一次，还是有点好处的)"))

(chain
 masked-move
 (normal "哈哈"))

(chain
 masked-move
 (color
  92 127 238 255
  (normal "班长？")))

(chain
 masked-move
 (normal "诶？……好烫！"))

(chain
 (fade (background corn-on-air) 2)
 2 (normal "啊，玉米……！"))

(chain
 (fade (background corn-try-catch) 0.5)
 1 (normal "…………！")
 )

(chain
 (fade (background corn-catch-successfull) 0.5)
 1 (normal "还好还好"))

(chain
 (fade (background corn-shy) 0.5)
 1 (normal "……啊"))

(chain
 (background corn-shy)
 (color
  92 127 238 255
  (normal "班长！好厉害啊！")))

(chain
 (fade (background corn-end) 1)
 1 (normal "啊哈哈"))

(chain
 (fade (background corn-end) 1)
 1 (normal "(已经……完了)"))

(chain
 (fade (background xin) 2))
