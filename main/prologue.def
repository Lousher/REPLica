(texture black "assets/bg/black.png")
(sound rightone "assets/sound/rightone.mp3")
(transition wakeup #f "assets/glsl/wakeup.transition.fs")
(sound searching "assets/sound/search.mp3")
(sound thud "assets/sound/thud.mp3")
(dialogue normal "assets/font/Xiaolai-Regular.ttf")
(texture morning "assets/bg/yuwen.bedroom.morning.png")
(effect appear #f "assets/glsl/appear.fs")
(phone yuwen-phone 400 850)
(texture calling "assets/picture/call.png")
(camera zoom-move (lambda (t) (values 0.0  0.0 (min (* 10 t) 300) 500.0 0.0 2.0)))
(transition fade #f "assets/glsl/fade.transition.fs")
(effect mask #f "assets/glsl/mask.effect.fs")
(camera zoom-move-start (lambda (t) (values 0.0 0.0 0.0 500.0 0.0 2.0)))
(sound pickup "assets/sound/pickup-phone.mp3")




