(game yuan
      (title "缘心饲契")
      (version 1.0)
      (team "叶缘社")
      (width 1920)
      (height 1080)
      (fps 60)
      (fullscreen? #f)
      (globals
       (events '())
       (title-screen-changed? #f))
      (bundles
       "b1.rpk"
       "p1.rpk")
      (resource
       [logo (texture "yeyuan")]
       [logo-voice (sound "yeah")]
       )
      (entry (opening logo logo-voice)))

(stage fade (to duration)
       (let* ([fade-sh (LoadShader #f "fade.fs")]
	      [texture1-location (GetShaderLocation fade-sh "texture1")]
	      [progress-location (GetShaderLocation fade-sh "progress")]
	      [f])
	 ()))

(stage splash (logo-tex logo-voice)
       (let* ([black (solid 1920 1080 BLACK)]
	      [white (solid 1920 1080 WHITE)]
	      [logo-centered-bg
	       (texture 1920 1080
			(show white)
			(at 960 540
			    (origin 0.5 0.5
				    (show logo-tex)))
			)])
	 (show black)
	 (wait 1.0)
	 (fade logo-centered-bg 1.0)
	 (play logo-voice)
	 (wait 1.0)
	 (fade white 1.0)
	 (menu ))
       )
