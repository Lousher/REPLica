(import (replica) (loader) (directive))

(*text* (string-append "诶，这就是桌游厅啊" "诶，这就是桌游厅啊" "然后这里是餐厅？"))

(let ()
  (texture menu "assets/picture/menu.png")
  (texture morning "assets/bg/yuwen.bedroom.morning.png")
  (texture yuwen "assets/yuwen/yuwen.date.png")
  (texture \x34;dspace "assets/bg/4dspace.png")
  (texture yuki "assets/ch-yuki/0896.png")
  (texture lehayuan "assets/bg/lehuayuan.png")
  (dialogue normal "assets/font/Xiaolai-Regular.ttf")
  (camera
    zoom-in
    (lambda (t) (values 0.0 0.0 500.0 100.0 0.0 2.0)))
  (transition fade #f "assets/glsl/fade.transition.fs")
  (inspector inspect)
  (*actions*
    (list
      (make-animation
        (parallel
          (background \x34;dspace)
          (character yuwen)
          (normal "诶，这就是桌游厅啊")))
      (make-animation
        (parallel
          (background \x34;dspace)
          (zoom-in (character yuwen))
          (normal "诶，这就是桌游厅啊")))
      (make-animation
        (parallel
          (background lehayuan)
          (character yuwen)
          (normal "然后这里是餐厅？"))))))

