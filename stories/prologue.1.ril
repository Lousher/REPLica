(import (replica) (loader) (directive))

(*text*
  (string-append "好痛！" "…………唉" "喂？" "喂？你还没起啊？" "有什么事吗"
   "啊，你今天回不回啊，家里刚买了个榴莲，我和你爸都吃不完" "把剩下的先冻着呗，也不着急这一天"
   "啊啊，可你不也好久没回了吗，今天回来刚好吃新鲜的" "我没那么想吃，你就先冻着吧" "这样啊" "嗯，还有什么事吗"
   "那你那边被子和棉絮要不要换下，我们带新的过去给你" "上周你不就让我洗过了吗，现在晒都晒完了" "……你究竟想干嘛啊"
   "啊，你说我们这不是好久没见了吗，今天稍微见一下呗" "啊啊……" "上次你这么说，然后就把我拉去见了个男的"
   "那是你爸他……" "那你让他打电话来说，别让你传话" "…………" "…………" "……那就这样，我这周加班也累了"
   "还有，过年我会回去的。不用太担心" "等下……" "唉…………" "上学时不让，上班后开催。他们都精神分裂吗"
   "我一个人不也过的好好的……" "………………" "五年了啊……" "在想什么啊我" "…………去过早吧"
   "stories/prologue.2"))

(let ()
  (texture black "assets/bg/black.png")
  (sound rightone "assets/sound/rightone.mp3")
  (transition wakeup #f "assets/glsl/wakeup.transition.fs")
  (sound searching "assets/sound/search.mp3")
  (sound thud "assets/sound/thud.mp3")
  (dialogue normal "assets/font/Xiaolai-Regular.ttf")
  (texture morning "assets/bg/yuwen.bedroom.morning.png")
  (effect appear #f "assets/glsl/appear.fs")
  (phone yuwen-phone 400 850)
  (texture calling "assets/picture/call.png")
  (camera
    zoom-move
    (lambda (t)
      (values 0.0 0.0 (min (* 10 t) 300) 500.0 0.0 2.0)))
  (transition fade #f "assets/glsl/fade.transition.fs")
  (effect mask #f "assets/glsl/mask.effect.fs")
  (camera
    zoom-move-start
    (lambda (t) (values 0.0 0.0 0.0 500.0 0.0 2.0)))
  (sound pickup "assets/sound/pickup-phone.mp3")
  (sound situp "assets/sound/situp.mp3")
  (sound walking "assets/sound/walking.mp3")
  (camera
    zoom-table
    (lambda (t) (values 0.0 0.0 1000.0 500.0 0.0 2.5)))
  (sound book-scrolling "assets/sound/scroll-books.mp3")
  (sound close-book "assets/sound/close-book.mp3")
  (sound hang-up "assets/sound/hang-up.mp3")
  (sound throw-on-bed "assets/sound/throw-on-bed.mp3")
  (camera
    zoom-bed-start
    (lambda (t) (values 0.0 0.0 0.0 500.0 0.0 2.0)))
  (camera
    zoom-bed-move
    (lambda (t)
      (values 0.0 0.0 0.0 (min 550.0 (+ 500.0 (* t 250))) 0.0
        2.0)))
  (texture bye-chat "assets/picture/bye.wechat.png")
  (sound gulu "assets/sound/gugu.mp3")
  (texture yuan "assets/picture/yuan.png")
  (define masked-bed-moving
    (mask (zoom-move (background morning)) 1))
  (define masked-bed-moving-saying
    (lambda (text) (parallel masked-bed-moving (normal text))))
  (define on-table (fade (zoom-table (background morning)) 1))
  (define on-bed (zoom-bed-move (background morning)))
  (*actions*
    (list
     (make-animation
       (parallel (play rightone) (background black)))
     (make-animation
       (parallel
         (wakeup (background morning) 2)
         (chain (play searching) 2.5 (stop searching) 0.5 (play thud)
           1.0 (normal "好痛！"))))
     (make-animation
       (parallel
         (background morning)
         (chain
           (appear (yuwen-phone calling) 1)
           1.5
           (normal "…………唉"))))
     (make-animation
       (chain (fade (zoom-move-start (background morning)) 1) 1
         (play pickup) masked-bed-moving 0.5 (normal "喂？")))
     (make-animation (masked-bed-moving-saying "喂？你还没起啊？"))
     (make-animation (masked-bed-moving-saying "有什么事吗"))
     (make-animation
       (masked-bed-moving-saying "啊，你今天回不回啊，家里刚买了个榴莲，我和你爸都吃不完"))
     (make-animation
       (masked-bed-moving-saying "把剩下的先冻着呗，也不着急这一天"))
     (make-animation
       (masked-bed-moving-saying "啊啊，可你不也好久没回了吗，今天回来刚好吃新鲜的"))
     (make-animation (masked-bed-moving-saying "我没那么想吃，你就先冻着吧"))
     (make-animation (masked-bed-moving-saying "这样啊"))
     (make-animation
       (chain (fade (background morning) 2) (play situp)
         (trigger (stop situp) 2) 2 (normal "嗯，还有什么事吗")))
     (make-animation
       (chain
         (background morning)
         (normal "那你那边被子和棉絮要不要换下，我们带新的过去给你")))
     (make-animation
       (chain (background morning) (normal "上周你不就让我洗过了吗，现在晒都晒完了")))
     (make-animation
       (chain (background morning) (normal "……你究竟想干嘛啊")))
     (make-animation
       (chain
         (background morning)
         (normal "啊，你说我们这不是好久没见了吗，今天稍微见一下呗")))
     (make-animation
       (chain (background morning) (normal "啊啊……") (play walking)))
     (make-animation
       (chain (background morning) (normal "上次你这么说，然后就把我拉去见了个男的")))
     (make-animation (chain on-table 1 (normal "那是你爸他……")))
     (make-animation
       (chain
         on-table
         (play book-scrolling)
         (normal "那你让他打电话来说，别让你传话")))
     (make-animation (chain on-table (normal "…………")))
     (make-animation (chain on-table (normal "…………")))
     (make-animation
       (chain on-table (stop book-scrolling) 1 (play close-book)
         (normal "……那就这样，我这周加班也累了")))
     (make-animation
       (chain
         (fade (background morning) 1)
         1
         (normal "还有，过年我会回去的。不用太担心")))
     (make-animation
       (chain
         (background morning)
         (normal "等下……")
         0.5
         (play hang-up)))
     (make-animation
       (chain (fade (zoom-bed-start (background morning)) 1)
         (play throw-on-bed) 1 on-bed 1 (normal "唉…………")))
     (make-animation
       (chain on-bed (normal "上学时不让，上班后开催。他们都精神分裂吗")))
     (make-animation (chain on-bed (normal "我一个人不也过的好好的……")))
     (make-animation (chain on-bed (normal "………………")))
     (make-animation
       (chain
         on-bed
         (appear (yuwen-phone bye-chat) 2)
         3
         (normal "五年了啊……")))
     (make-animation
       (chain (fade (static black) 1) 1 (normal "在想什么啊我")))
     (make-animation
       (chain (static black) (play gulu) 3 (normal "…………去过早吧")))
     (make-animation (fade (background yuan) 2))
     (make-animation (fade (static black) 1))
     (jump "stories/prologue.2"))))

