(load "stories/prologue.1.def")

(parallel
 (play rightone)
 (background black))

(parallel
 (wakeup (background morning) 2)
 (chain
  (play searching) 2.5
  (stop searching) 0.5
  (play thud) 1.0
  (normal "好痛！")))

(parallel
 (background morning)
 (chain
  (appear (yuwen-phone calling) 1)
  1.5 (normal "…………唉")))

(define masked-bed-moving
  (mask (zoom-move (background morning)) 1))
(define masked-bed-moving-saying
  (lambda (text)
    (parallel
     masked-bed-moving
     (normal text))))

(chain
 (fade (zoom-move-start (background morning)) 1)
 1
 (play pickup)
 masked-bed-moving
 0.5
 (normal "喂？"))

(masked-bed-moving-saying
 "喂？你还没起啊？")
(masked-bed-moving-saying
 "有什么事吗")
(masked-bed-moving-saying
 "啊，你今天回不回啊，家里刚买了个榴莲，我和你爸都吃不完")
(masked-bed-moving-saying
 "把剩下的先冻着呗，也不着急这一天")

(masked-bed-moving-saying
 "啊啊，可你不也好久没回了吗，今天回来刚好吃新鲜的")

(masked-bed-moving-saying
 "我没那么想吃，你就先冻着吧")

(masked-bed-moving-saying
 "这样啊")

(chain
(fade (background morning) 2)
(play situp)
(trigger (stop situp) 2)
2
(normal "嗯，还有什么事吗"))

(chain
 (background morning)
 (normal "那你那边被子和棉絮要不要换下，我们带新的过去给你"))

(chain
 (background morning)
 (normal "上周你不就让我洗过了吗，现在晒都晒完了"))

(chain
 (background morning)
 (normal "……你究竟想干嘛啊"))

(chain
 (background morning)
 (normal "啊，你说我们这不是好久没见了吗，今天稍微见一下呗"))

(chain
(background morning)
 (normal "啊啊……")
 (play walking))

(chain
 (background morning)
 (normal "上次你这么说，然后就把我拉去见了个男的"))

(define on-table  (fade (zoom-table (background morning)) 1))
(chain
 on-table
 1
 (normal "那是你爸他……"))

(chain
 on-table
 (play book-scrolling)
 (normal "那你让他打电话来说，别让你传话"))

(chain
 on-table
 (normal "…………"))

(chain
 on-table
 (normal "…………"))

(chain
 on-table
 (stop book-scrolling)
 1
 (play close-book)
 (normal "……那就这样，我这周加班也累了"))

(chain
 (fade (background morning) 1)
 1
 (normal "还有，过年我会回去的。不用太担心")
 )

(chain
 (background morning)
 (normal "等下……")
 0.5 (play hang-up))

(define on-bed (zoom-bed-move (background morning)))

(chain
 (fade (zoom-bed-start (background morning)) 1)
 (play throw-on-bed)
 1
 on-bed
 1
 (normal "唉…………"))

(chain
on-bed
(normal "上学时不让，上班后开催。他们都精神分裂吗"))

(chain
on-bed
(normal "我一个人不也过的好好的……"))

(chain
on-bed
(normal "………………"))

(chain
on-bed
(appear (yuwen-phone bye-chat) 1)
1
(normal "…………"))

(chain
 (fade (static black) 1)
 1
 (normal "在想什么啊我"))

(chain
(static black)
(play gulu)
3
(normal "…………去过早吧"))

(fade (background yuan) 2)
(fade (static black) 1)

(jump "stories/prologue.2")
