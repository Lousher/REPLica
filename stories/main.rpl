(texture menu "assets/picture/menu.png")
(texture morning "assets/bg/yuwen.bedroom.morning.png")
(texture yuwen "assets/yuwen/yuwen.date.png")
(texture 4dspace "assets/bg/4dspace.png")
(texture yuki "assets/ch-yuki/0896.png")
(texture lehayuan "assets/bg/lehuayuan.png")
(dialogue normal "assets/font/Xiaolai-Regular.ttf")
(camera zoom-in (lambda (t) (values 0.0 0.0 500.0 100.0 0.0 2.0)))
(transition fade #f "assets/glsl/fade.transition.fs")
(effect appear #f "assets/glsl/appear.fs")
(inspector inspect)

(parallel	
  (background 4dspace)
   (character yuwen)
   (normal "诶，这就是桌游厅啊"))

(fade (background lehayuan) 2)

(parallel
 (background lehayuan)
 (appear (character yuwen) 2)
 (normal "然后这里是餐厅？"))
