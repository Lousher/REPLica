(assets
 (bedroom
  (morning "yuwen.bedroom.morning.png")
  (afternoon "yuwen.bedroom.afternoon.png")
  (night "yuwen.bedroom.night.png")
  (night-with-light "yuwen.bedroom.night.light.png"))
 (yuki (smile "0895.png")
       (happy "0898.png")
       (star-eye "0911.png"))
 (yuki-va (first "1.new.ogg")
	  (second "2.new.ogg"))
 (bgm (midnight "midnight-trip.mp3"))
 (ring (rightone "rightone.mp3")))

(scene (bedroom morning))
(sound (ring rightone))

(wait click)

(camera (let ([passed 0.0]
	      [camera (init-Camera2D)]
	      [left-bottom `(0.0 . ,(* *SCREEN-HEIGHT* 1.0))])
	  (Camera2D-offset-set! camera left-bottom)
	  (Camera2D-zoom-set! camera 2.0)
	  (lambda (x)
	    (when (<= passed 250.0)
	      (set! passed (+ passed 0.5)))
	    (Camera2D-target-set! camera (cons passed (exact->inexact *SCREEN-HEIGHT*)))
	    camera)))

(effect mask-on)

(wait click)
(camera reset)

(wait click)
(effect mask-off)
