(scene :location (station night))
(scene :characters `#(#f #f ,(yuki happy) #f #f))
(scene :text "" "唉，不知道什么时候的事情呢" :voice (yuki second))
(music :play (bgm midnight))

(scene :location (station morning)
		:characters `#(#f #f ,(yuki smile) #f #f)
		:voice (yuki first)
		:text "苏喻文" "好久不见啊，应该有七年了吧" 
		:transition (wipe right))

(scene :location (station evening)
       :characters `#(#f #f ,(yuki happy) #f #f)
       :voice (yuki second)
       :text "苏喻文" "没想到你居然在求富婆包养啊")


