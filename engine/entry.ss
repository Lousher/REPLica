(library (engine entry)
  (export run)
  (import (chezscheme)
	  (raylib ffi)
	  (raylib constant)
	  (scene node)
	  (scene renderer)
	  (engine state)
	  (engine resource))

  (define run
    (lambda (story)
      (InitWindow 1920 1080 "REPLica Engine")
      (InitAudioDevice)
      (cache "test.png")
      (cache "test2.png")
      (let* ([root (make-root-node 1920 1080)]
	     [game (make-state root)])
	(let loop ([time 0.0])
	  (unless (WindowShouldClose)
	    (story game)
	    (BeginDrawing)
	    (ClearBackground BLACK)
	    (render root)
	    (EndDrawing)
	    (loop (+ time (GetFrameTime)))))
	)
      
      (CloseAudioDevice)
      (CloseWindow)))
  )
